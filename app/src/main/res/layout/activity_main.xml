<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_battery_remapper" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_pill_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/app_version_default"
            android:textColor="@color/brand_on_container"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/btnRefreshSystemUi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_refresh_button"
            android:contentDescription="@string/restart_system_ui"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            android:tint="@null"
            android:tooltipText="@string/restart_system_ui" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topAppBar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/Widget.BatteryRemapper.SectionLabel"
                android:text="@string/section_status" />

            <LinearLayout
                android:id="@+id/cardHookStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_status_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/shape_status_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/status_pending_title"
                        android:textColor="@color/brand_on_container"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/status_pending_description"
                        android:textColor="@color/status_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.BatteryRemapper.SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/section_remapping" />

            <LinearLayout
                android:id="@+id/cardBatteryRemapper"
                style="@style/Widget.BatteryRemapper.ToggleCard"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardTitle"
                        android:text="@string/remapper_title" />

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardDescription"
                        android:text="@string/remapper_description" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchBatteryRemapper"
                    style="@style/Widget.BatteryRemapper.Switch"
                    android:contentDescription="@string/remapper_title" />
            </LinearLayout>

            <TextView
                style="@style/Widget.BatteryRemapper.SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/section_automation" />

            <LinearLayout
                android:id="@+id/cardBatterySaver"
                style="@style/Widget.BatteryRemapper.ToggleCard"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardTitle"
                        android:text="@string/battery_saver_title" />

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardDescription"
                        android:text="@string/battery_saver_description" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchBatterySaver"
                    style="@style/Widget.BatteryRemapper.Switch"
                    android:contentDescription="@string/battery_saver_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAutoShutdown"
                style="@style/Widget.BatteryRemapper.ToggleCard"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardTitle"
                        android:text="@string/auto_shutdown_title" />

                    <TextView
                        style="@style/Widget.BatteryRemapper.CardDescription"
                        android:text="@string/auto_shutdown_description" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAutoShutdown"
                    style="@style/Widget.BatteryRemapper.Switch"
                    android:contentDescription="@string/auto_shutdown_title" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/settings_note"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

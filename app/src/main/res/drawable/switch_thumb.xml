<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled thumb -->
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />

            <solid android:color="@color/switch_thumb_disabled" />
        </shape>
    </item>

    <!-- Checked thumb -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />

            <solid android:color="@color/switch_thumb_on" />
        </shape>
    </item>

    <!-- Unchecked thumb -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />

            <solid android:color="@color/switch_thumb_off" />
        </shape>
    </item>

</selector>

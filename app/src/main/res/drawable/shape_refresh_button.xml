<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CDBE99" />

            <stroke
                android:width="1dp"
                android:color="#4073784B" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#E2D2AE" />

            <stroke
                android:width="1dp"
                android:color="#3073784B" />
        </shape>
    </item>

</selector>
